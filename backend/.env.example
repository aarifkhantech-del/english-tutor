# Mistral Cloud API Key
MISTRAL_API_KEY=your_mistral_api_key_here

# MongoDB Atlas Database
# Atlas Network Access must include this machine's public IP (TLS handshake fails otherwise).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vocalbharat?retryWrites=true&w=majority
MONGODB_DB_NAME=vocalbharat

# Google Sign-In: the OAuth 2.0 Web client ID from Google Cloud Console.
# Add the Android app's SHA-1/SHA-256 and package name in that same OAuth project.
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PAYMENT_GATEWAY=razorpay
